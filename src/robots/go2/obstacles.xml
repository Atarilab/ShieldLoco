<mujocoinclude>

    <!-- Obstacles in robot's path - Box type with known positions -->
    <!-- Format: pos="x y z" where z is half-height, size="half_x half_y half_z" -->
    <!-- 5 boxes total, one per row, scattered at different y positions, avoiding y=0 (direct front) -->

    <!-- Row 1: x=1.5m, offset to the left -->
    <geom name="obstacle_0" pos="1.5 -0.3 0.2" type="box" size="0.15 0.15 0.2" rgba="0.8 0.2 0.2 1" friction="1.0"/>

    <!-- Row 2: x=2.5m, offset to the right -->
    <geom name="obstacle_1" pos="3.0 0.5 0.2" type="box" size="0.15 0.15 0.2" rgba="0.8 0.2 0.2 1" friction="1.0"/>

    <!-- Row 3: x=3.5m, offset to the left -->
    <geom name="obstacle_2" pos="4.0 0.0 0.2" type="box" size="0.15 0.15 0.2" rgba="0.8 0.2 0.2 1" friction="1.0"/>

    <!-- Row 4: x=4.5m, offset slightly right -->
    <geom name="obstacle_3" pos="4.7 -0.8 0.2" type="box" size="0.15 0.15 0.2" rgba="0.8 0.2 0.2 1" friction="1.0"/>

    <!-- Row 5: x=5.5m, offset to the left -->
    <geom name="obstacle_4" pos="5.5 0.0 0.2" type="box" size="0.15 0.15 0.2" rgba="0.8 0.2 0.2 1" friction="1.0"/>

    <!-- DESTINATION MARKER at (6.5, 0.0, 0.2) -->
    <!-- Green X-shaped marker made of two thin crossed boxes -->
    <geom name="destination_x_1" pos="6.5 0.0 0.05" type="box" size="0.3 0.02 0.05" rgba="0.0 1.0 0.0 1" quat="0.9239 0 0 0.3827" contype="0" conaffinity="0"/>
    <geom name="destination_x_2" pos="6.5 0.0 0.05" type="box" size="0.3 0.02 0.05" rgba="0.0 1.0 0.0 1" quat="0.9239 0 0 -0.3827" contype="0" conaffinity="0"/>

    <!-- Finish line - Two vertical poles with horizontal bar -->
    <geom name="finish_pole_left" pos="6.5 -0.5 0.4" type="cylinder" size="0.03 0.4" rgba="1.0 1.0 1.0 1" contype="0" conaffinity="0"/>
    <geom name="finish_pole_right" pos="6.5 0.5 0.4" type="cylinder" size="0.03 0.4" rgba="1.0 1.0 1.0 1" contype="0" conaffinity="0"/>
    <geom name="finish_bar" pos="6.5 0.0 0.75" type="box" size="0.02 0.5 0.02" rgba="1.0 1.0 1.0 1" contype="0" conaffinity="0"/>

</mujocoinclude>