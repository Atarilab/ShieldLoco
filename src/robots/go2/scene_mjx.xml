<mujoco model="go2 scene">
  <include file="go2_mjx.xml"/>
  <statistic center="0 0 0.1" extent="0.8"/>
  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-130" elevation="-20"/>
  </visual>
  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>
  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane" friction="1.3"/>

    <!-- Obstacles in robot's path - Box type with known positions -->
    <!-- Format: pos="x y z" where z is half-height, size="half_x half_y half_z" -->
    <!-- 5 boxes total, one per row, scattered at different y positions, avoiding y=0 (direct front) -->

    <!-- Row 1: x=1.5m, offset to the left -->
    <geom name="obstacle_0" pos="1.5 -0.3 0.2" type="box" size="0.15 0.15 0.2" rgba="0.8 0.2 0.2 1" friction="1.0"/>

    <!-- Row 2: x=2.5m, offset to the right -->
    <geom name="obstacle_1" pos="3.0 0.5 0.2" type="box" size="0.15 0.15 0.2" rgba="0.8 0.2 0.2 1" friction="1.0"/>

    <!-- Row 3: x=3.5m, offset to the left -->
    <geom name="obstacle_2" pos="4.0 0.0 0.2" type="box" size="0.15 0.15 0.2" rgba="0.8 0.2 0.2 1" friction="1.0"/>

    <!-- Row 4: x=4.5m, offset slightly right -->
    <geom name="obstacle_3" pos="4.7 -0.8 0.2" type="box" size="0.15 0.15 0.2" rgba="0.8 0.2 0.2 1" friction="1.0"/>

    <!-- Row 5: x=5.5m, offset to the left -->
    <geom name="obstacle_4" pos="5.5 0.0 0.2" type="box" size="0.15 0.15 0.2" rgba="0.8 0.2 0.2 1" friction="1.0"/>

    <!-- DESTINATION MARKER at (6.5, 0.0, 0.2) -->
    <!-- Green X-shaped marker made of two thin crossed boxes -->
    <geom name="destination_x_1" pos="6.5 0.0 0.05" type="box" size="0.3 0.02 0.05" rgba="0.0 1.0 0.0 1" quat="0.9239 0 0 0.3827"/>
    <geom name="destination_x_2" pos="6.5 0.0 0.05" type="box" size="0.3 0.02 0.05" rgba="0.0 1.0 0.0 1" quat="0.9239 0 0 -0.3827"/>

    <!-- Finish line - Two vertical poles with horizontal bar -->
    <geom name="finish_pole_left" pos="6.5 -0.5 0.4" type="cylinder" size="0.03 0.4" rgba="1.0 1.0 1.0 1"/>
    <geom name="finish_pole_right" pos="6.5 0.5 0.4" type="cylinder" size="0.03 0.4" rgba="1.0 1.0 1.0 1"/>
    <geom name="finish_bar" pos="6.5 0.0 0.75" type="box" size="0.02 0.5 0.02" rgba="1.0 1.0 1.0 1"/>

  </worldbody>
</mujoco>